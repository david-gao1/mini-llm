{
  "run_name": "gpt2_medium_wikitext103",
  "seed": 42,
  "data": {
    "source": "huggingface",
    "hf_path": "Salesforce/wikitext",
    "hf_name": "wikitext-103-raw-v1",
    "hf_split": "train",
    "filename": "wikitext103_raw_train.txt",
    "train_ratio": 0.95,
    "max_chars": null
  },
  "model": {
    "vocab_size": 50257,
    "context_length": 1024,
    "emb_dim": 1024,
    "n_heads": 16,
    "n_layers": 24,
    "drop_rate": 0.1,
    "qkv_bias": false
  },
  "train": {
    "learning_rate": 0.0003,
    "weight_decay": 0.1,
    "num_epochs": 3,
    "batch_size": 4,
    "eval_freq": 500,
    "eval_iter": 10,
    "checkpoint_every_steps": 2000,
    "start_context": "The history of",
    "grad_clip": 1.0,
    "warmup_ratio": 0.1,
    "min_lr_ratio": 0.1,
    "patience": 20
  },
  "device": "auto",
  "output_dir": "runs"
}
