{
  "run_name": "team_gpt",
  "seed": 123,
  "data": {
    "url": "https://raw.githubusercontent.com/rasbt/LLMs-from-scratch/main/ch02/01_main-chapter-code/the-verdict.txt",
    "filename": "the-verdict.txt",
    "train_ratio": 0.9,
    "max_chars": null
  },
  "model": {
    "vocab_size": 50257,
    "context_length": 256,
    "emb_dim": 384,
    "n_heads": 6,
    "n_layers": 6,
    "drop_rate": 0.2,
    "qkv_bias": false
  },
  "train": {
    "learning_rate": 0.0003,
    "weight_decay": 0.2,
    "num_epochs": 50,
    "batch_size": 8,
    "eval_freq": 20,
    "eval_iter": 5,
    "checkpoint_every_steps": 200,
    "start_context": "Every effort moves you",
    "grad_clip": 1.0,
    "warmup_ratio": 0.1,
    "min_lr_ratio": 0.1,
    "patience": 10
  },
  "device": "auto",
  "output_dir": "runs"
}
