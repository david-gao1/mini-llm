  "train": {
    "learning_rate": 0.0003,
    "weight_decay": 0.1,
    "num_epochs": 1,
    "batch_size": 8,
    "eval_freq": 5,
    "eval_iter": 1,
    "checkpoint_every_steps": 50,
    "start_context": "Every effort moves you"
  },
  "device": "auto",
  "output_dir": "runs"
}
