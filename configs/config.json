{
  "run_name": "team_gpt",
  "seed": 123,
  "data": {
    "url": "https://raw.githubusercontent.com/rasbt/LLMs-from-scratch/main/ch02/01_main-chapter-code/the-verdict.txt",
    "filename": "the-verdict.txt",
    "train_ratio": 0.9,
    "max_chars": null
  },
  "model": {
    "vocab_size": 50257,
    "context_length": 64,
    "emb_dim": 128,
    "n_heads": 4,
    "n_layers": 2,
    "drop_rate": 0.1,
    "qkv_bias": false
